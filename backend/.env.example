# ODDLY API configuration. Copy to backend/.env and fill in. Never commit .env.

# Supabase Postgres. Use the "Session pooler" connection string from
# Supabase -> Project Settings -> Database -> Connection string (port 5432).
# The transaction pooler (port 6543) does not support prepared statements.
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres?sslmode=require
DATABASE_MAX_CONNECTIONS=10

# Supabase -> Project Settings -> API
SUPABASE_URL=https://<project-ref>.supabase.co
# Secret key (sb_secret_...) or legacy service_role key. Server-side only.
SUPABASE_SECRET_KEY=
# Only for projects still on the legacy shared JWT secret (HS256).
# Leave empty if the project uses JWT signing keys (verified via JWKS).
SUPABASE_JWT_SECRET=

# Where the API listens. On hosting platforms leave this empty: PORT is used (0.0.0.0:$PORT).
API_BIND_ADDR=127.0.0.1:8080

# Set to true when running behind a hosting proxy / load balancer, so rate limiting uses
# the real client IP from X-Forwarded-For instead of the proxy's.
TRUST_PROXY=

# Origins allowed to call the API (comma-separated).
# Dev server, Tauri on Windows, Tauri on macOS/Linux.
CORS_ALLOWED_ORIGINS=http://localhost:1420,http://tauri.localhost,tauri://localhost

# Optional: require this token to create the first owner account.
# Strongly recommended when the API is reachable from the internet.
SETUP_TOKEN=

# Requests per minute per client IP.
RATE_LIMIT_PER_MINUTE=600

# AI assistant. Server-side only — never put this key in the apps.
# Leave empty to keep AI switched off (the apps say so instead of faking answers).
OPENAI_API_KEY=
# Optional: model (default gpt-4.1-mini) and an OpenAI-compatible endpoint.
OPENAI_MODEL=
OPENAI_BASE_URL=

RUST_LOG=oddly_api=info,tower_http=info

# Encrypts website credentials (AES-256-GCM): 32 random bytes, base64.
# Generate with a cryptographic RNG, e.g.: openssl rand -base64 32
# Back it up safely: stored credentials can't be decrypted without it.
SECRETS_KEY=
