{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ODDLY",
  "version": "1.0.1",
  "identifier": "com.oddly.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "ODDLY",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 700,
        "center": true,
        "backgroundColor": "#0B0B0C"
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: http://ipc.localhost; connect-src 'self' ipc: http://ipc.localhost http://localhost:8080 http://127.0.0.1:8080 https: wss://*.supabase.co; img-src 'self' data: blob: https:; media-src 'self' blob: https:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Business",
    "shortDescription": "Everything your agency needs. All in one place.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "publisher": "ODDLY",
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDI4NUU0QTMxMzhCNEEzNUUKUldSZW83UTRNVXBlS0plY1E3QVhKc0tnVU5uLytNVnJEU2Z2T24xanpUdGJXRUdMSWtDSGRHZG0K",
      "endpoints": [
        "https://scout.remarugsimar.com/api/v1/updates/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
