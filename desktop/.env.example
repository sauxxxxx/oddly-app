# ODDLY desktop configuration. Copy to desktop/.env and fill in.
# These values are compiled into the app and are PUBLIC by design:
# the anon/publishable key cannot read ODDLY data (RLS denies everything),
# so never put the Supabase secret key, database URL or OpenAI key here.

# ODDLY API base URL (the Rust backend).
VITE_API_URL=http://localhost:8080/api/v1

# Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=
